# ============================================================
# 🟢 DEPENDENCIAS NODE.JS / FRONTEND
# ============================================================
node_modules/
jspm_packages/
bower_components/

# Lock files — CONSERVA SOLO UNO (el de tu gestor), comenta los demás
# package-lock.json    # ← Descomenta si usas NPM
# pnpm-lock.yaml        # ← Descomenta si usas PNPM
# bun.lock              # ← Descomenta si usas Bun
# yarn.lock             # ← Descomenta si usas Yarn

# ============================================================
# 🟡 PYTHON / FASTAPI / BACKEND
# ============================================================
# Byte-compilado / cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc

# Entornos virtuales
venv/
env/
ENV/
.venv/
.env/
virtualenv/
venv.bak/

# Archivos de respaldo
*.bak
*.backup
*.tmp
*.swp
*.swo
*~

# Distribución / builds
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Testing / cobertura
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover

# Linters / formateadores
.mypy_cache/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# ============================================================
# 🔴 VARIABLES DE ENTORNO (NUNCA SUBIR A GIT)
