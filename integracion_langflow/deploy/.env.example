# LangFlow (interfaz visual) — GDA
# Copie este archivo a .env y ajuste los valores.
# Windows PowerShell:  $env:LANGFLOW_HOST = "http://localhost:7860"

# ── Servidor LangFlow ───────────────────────────────────────────────────
LANGFLOW_HOST=http://localhost:7860
LANGFLOW_PORT=7860
LANGFLOW_URL_UI=http://localhost:7860
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SECRET_KEY=cambie-esta-clave-en-produccion
LANGFLOW_API_KEY=

# Ruta que LangFlow inspecciona para descubrir los componentes del GDA.
# Debe apuntar a la carpeta "components" (no a la raíz del paquete).
LANGFLOW_COMPONENTS_PATH=./integracion_langflow/components

# LangChain/LangGraph ya los instala LangFlow; los valores de abajo son los
# que usa el resto del proyecto (requisitos_orquestador.txt).
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=false

# ── Backend GDA ─────────────────────────────────────────────────────────
# URL con la que LangFlow (y el frontend) llaman al backend FastAPI.
GDA_API_BASE=http://localhost:8000/api/v1

# ── Persistencia de LangFlow (opcional) ─────────────────────────────────
# Descomente para guardar los flujos en el mismo PostgreSQL del sistema.
# Cree antes la base de datos "langflow".
# LANGFLOW_DATABASE_URL=postgresql+asyncpg://gda:clave@localhost:5432/langflow
# LANGFLOW_SQLITE_URL=./langflow.db

# ── Redis compartido (Celery + caché de LangFlow) ──────────────────────
# REDIS_URL=redis://localhost:6379/0
